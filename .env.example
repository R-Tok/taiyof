# キー名の見本です。値は書きません。
# 開発機の実値は .env.local（Git に入らない）
# Vercel の実値は Project Settings → Environment Variables
# どの欄に何を書くかは docs/email-env.md

MICROCMS_SERVICE_DOMAIN=
MICROCMS_API_KEY=

# Resend の API Keys。開発と Vercel で同じキーを使ってよい
RESEND_API_KEY=

# 問い合わせの受信先
# .env.local と Vercel の Preview: Resend に登録した Gmail
# Vercel の Production: 会社の独自ドメインアドレス（例 info@taiyo-f.net）
CONTACT_TO_EMAIL=

# 差出人。空なら onboarding@resend.dev
# Production で会社アドレスから送るときだけ、検証済みドメインのアドレスを書く
CONTACT_FROM_EMAIL=
